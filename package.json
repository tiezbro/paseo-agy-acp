{
  "name": "paseo-agy-acp",
  "version": "2.8.1",
  "description": "Paseo ACP adapter for the official Google Antigravity kernel with daemon context, skills and protocol compatibility",
  "type": "module",
  "author": {
    "name": "tiezbro"
  },
  "homepage": "https://github.com/tiezbro/paseo-agy-acp#readme",
  "bugs": {
    "url": "https://github.com/tiezbro/paseo-agy-acp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiezbro/paseo-agy-acp.git"
  },
  "keywords": [
    "acp",
    "agent",
    "antigravity",
    "google",
    "paseo"
  ],
  "main": "dist/ACP Connector/agent.js",
  "types": "dist/ACP Connector/agent.d.ts",
  "license": "Apache-2.0",
  "bin": {
    "paseo-agy-acp": "dist/ACP Connector/main.js",
    "agy-acp": "dist/ACP Connector/main.js",
    "agy-acp-prepare-official-kernel-compat": "scripts/prepare-official-kernel-compat.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scripts/prepare-official-kernel-compat.mjs",
    "assets/official-kernel-compat/rc01/paseo_model_compat.py",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && npm run build && vitest run",
    "test:paseo-client": "npm run validate:paseo-client-lock && npm run build && node scripts/run-paseo-client-tests.mjs",
    "test:paseo-provider": "npm run build && node --test tests/paseo-provider-platform.test.mjs",
    "validate:architecture": "node scripts/verify-import-boundaries.mjs",
    "validate:secrets": "node scripts/verify-no-secrets.mjs",
    "validate": "npm test && npm run validate:architecture && npm run validate:secrets && node --test tests/paseo-live-config.test.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "validate:paseo-client-lock": "node scripts/verify-paseo-client-lock.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
